# Xcode / Swift
build/
DerivedData/
*.xcuserstate
xcuserdata/
*.xcworkspace/xcuserdata/
.DS_Store

# Swift Package Manager (if added later)
.build/
.swiftpm/

# Signing / secrets
*.mobileprovision
!Mattermost/Mattermost.entitlements

# Test/coverage artefacts
*.profraw
*.profdata

# Parallel-work checkouts live INSIDE the repo (git worktrees), so they must never
# be tracked: one `git add -A` would otherwise sweep a whole second checkout into
# a commit. `scripts/verify-pushed.py` fails the card if any of this is tracked.
.worktrees/

# Editor
.vscode/
.idea/

# Vendored upstream Mattermost Push Proxy (nested git + 51MB build binary)
# Provenance is recorded in PushProxy/upstream_manifest.json, not the tree itself.
PushProxy/upstream/
