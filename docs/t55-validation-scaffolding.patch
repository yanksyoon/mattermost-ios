+    // MARK: - T55 re-validation: the same question on a day the fixture separates
+
+    /// T39-R's live proof uses the *newest* post's day. As the fixture grows that day fills with posts
+    /// created after 00:00 local, and the two encodings answer the SAME set — measured by
+    /// T55's `tz_separation_probe.py` on 2026-10-27 (seconds 2, minutes 2) while 2026-10-26 still
+    /// separates them (seconds 1, minutes 3). The shipped test then self-skips ("the fixture no longer
+    /// separates the two offsets"), so it cannot witness F1 any more.
+    ///
+    /// This is the adversarial re-derivation: a fixed day the fixture does separate, the same server
+    /// oracle, and the screen's own count compared against it. It is validation-only — it lives in the
+    /// audit worktree and is not committed to main.
+    func testT55OnDateOffsetOnAFixtureDayThatSeparates() throws {
+        let secondsOffset = TimeZone.current.secondsFromGMT()
+        try XCTSkipUnless(secondsOffset != 0 && secondsOffset % 3600 == 0,
+                          "this host's offset \(secondsOffset)s cannot separate seconds from minutes")
+        let minutesOffset = secondsOffset / 60
+        let day = "2026-10-26"
+        let terms = "in:t34-showcase on:\(day)"
+
+        let secondsCount = try searchIDs(terms: terms, timeZoneOffsetSeconds: secondsOffset).count
+        let minuteCount = try searchIDs(terms: terms, timeZoneOffsetSeconds: minutesOffset).count
+        try XCTSkipUnless(secondsCount != minuteCount,
+                          "the fixture no longer separates \(terms): both \(secondsCount)")
+
+        let app = launchApp()
+        openSearch(app)
+        type(terms, into: "searchField", in: app)
+        element(app, "searchSubmit").tap()
+
+        let summary = element(app, "searchSummary")
+        XCTAssertTrue(summary.waitForExistence(timeout: 40), "no summary:\n\(app.debugDescription)")
+        let label = summary.label
+        let shown = Int(label.prefix(while: { $0.isNumber })) ?? -1
+        attach(app, "t55-ondate-fixed-day")
+        XCTAssertEqual(shown, secondsCount,
+                       "the screen shows \(shown) for \(terms); seconds reads \(secondsCount), "
+                       + "minutes reads \(minuteCount). Summary: \(label)")
+    }
+
